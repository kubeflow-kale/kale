{% import '_step_config.jinja2' as step_config -%}
import json
{% if returns %}from typing import NamedTuple
{% endif %}{% if modules %}import os
import sys

{% endif %}import kfp.dsl as kfp_dsl
from kfp.dsl import Input, Output, Dataset, HTML, Metrics, Artifact, Model
from kfp.kubernetes import add_pod_annotation, add_pod_label, security_context
{%- if volumes | default([]) | selectattr('type', 'equalto', 'pvc') | list %}
from kfp import kubernetes
{%- endif %}
{% if modules %}
# The notebooks this one references are generated next to it; make them
# importable regardless of where this script is executed from. kfp is imported
# above, before the path mutation, so no generated module can shadow it.
_here = os.path.dirname(os.path.abspath(__file__))
if _here not in sys.path:
    sys.path.insert(0, _here)

{% for m in modules %}from {{ m }} import {{ m }}_pipeline
{% endfor %}{% endif %}
{{ components | join('\n\n') }}

@kfp_dsl.pipeline(
    name='{{ pipeline_name }}',
    description='{{ pipeline_description }}'
)
def {{ fn }}({{ signature }}){% if returns|length == 1 %} -> {{ returns[0].type }}{% elif returns|length > 1 %} -> NamedTuple('Outputs', [{% for o in returns %}('{{ o.var }}', {{ o.type }}){% if not loop.last %}, {% endif %}{% endfor %}]){% endif %}:
    """{{ docstring }}"""
{% for t in tasks %}
    {{ t.task_var }} = {{ t.fn }}(
    {%- for inp in t.inputs %}
        {{ inp.arg }}={{ inp.ref }}{% if not loop.last %},{% endif %}
    {%- endfor %}
    )
{%- if t.is_component %}{{ step_config.security(t.task_var, security_context) }}{% endif %}
{% for a in t.after %}    {{ t.task_var }}.after({{ a }})
{% endfor %}
    {{ t.task_var }}.set_display_name("{{ t.display }}")
{% if t.is_component %}{{- step_config.render(t.node, t.task_var, enable_caching, volumes) }}
{%- else %}{{- step_config.caching(t.node, t.task_var, enable_caching) }}{% endif %}
{% endfor %}
{% if returns|length == 1 %}    return {{ returns[0].ref }}
{% elif returns|length > 1 %}    return NamedTuple('Outputs', [{% for o in returns %}('{{ o.var }}', {{ o.type }}){% if not loop.last %}, {% endif %}{% endfor %}])({% for o in returns %}{{ o.var }}={{ o.ref }}{% if not loop.last %}, {% endif %}{% endfor %})
{% endif %}

if __name__ == "__main__":
    from kfp import compiler

    compiler.Compiler().compile({{ fn }}, "{{ pipeline_name }}.yaml")

    print("Pipeline compiled to {{ pipeline_name }}.yaml")
    print("To run, upload this YAML to your KFP v2 instance or use kfp.Client().create_run_from_pipeline_func.")
