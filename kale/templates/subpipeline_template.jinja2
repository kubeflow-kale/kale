{% import '_step_config.jinja2' as step_config -%}
import json
from typing import NamedTuple
import kfp.dsl as kfp_dsl
from kfp.dsl import Input, Output, Dataset, HTML, Metrics, Artifact, Model
from kfp.kubernetes import add_pod_annotation, add_pod_label, security_context

{{ sp.components | join('\n\n') }}


@kfp_dsl.pipeline(name='{{ sp.display }}')
def {{ sp.module }}_pipeline({{ sp.signature }}){% if sp.outputs|length == 1 %} -> {{ sp.outputs[0].type }}{% elif sp.outputs|length > 1 %} -> NamedTuple('Outputs', [{% for o in sp.outputs %}('{{ o.var }}', {{ o.type }}){% if not loop.last %}, {% endif %}{% endfor %}]){% endif %}:
    """Sub-pipeline compiled from notebook '{{ sp.display }}'."""
{% for t in sp.tasks %}
    {{ t.task_var }} = {{ t.fn }}({% for inp in t.inputs %}{{ inp.arg }}={{ inp.ref }}{% if not loop.last %}, {% endif %}{% endfor %})
{{- step_config.security(t.task_var, sp.security_context) }}
    {{ t.task_var }}.set_display_name("{{ t.display }}")
{{- step_config.render(t.step, t.task_var, sp.enable_caching) }}
{% for a in t.after %}    {{ t.task_var }}.after({{ a }})
{% endfor %}
{% endfor %}
{% if sp.outputs|length == 1 %}    return {{ sp.outputs[0].ref }}
{% elif sp.outputs|length > 1 %}    return NamedTuple('Outputs', [{% for o in sp.outputs %}('{{ o.var }}', {{ o.type }}){% if not loop.last %}, {% endif %}{% endfor %}])({% for o in sp.outputs %}{{ o.var }}={{ o.ref }}{% if not loop.last %}, {% endif %}{% endfor %})
{% endif %}

if __name__ == "__main__":
    from kfp import compiler

    compiler.Compiler().compile({{ sp.module }}_pipeline, "{{ sp.display }}.yaml")
    print("Sub-pipeline compiled to {{ sp.display }}.yaml")
